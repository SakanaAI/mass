# Optional credentials for external workspace evaluation and benchmark judging.
# Copy this file to .env and load it into your shell as described in docs/running.md.
# Local workflow search and post-training do not need these provider credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional remote inference for rollout, workflow search, collection, and ranking.
# See docs/openrouter.md. Keep the value in your environment or ignored .env only.
OPENROUTER_API_KEY=
